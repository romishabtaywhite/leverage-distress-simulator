# Copy this file to .env and fill in your own values. .env is gitignored.

# Free FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR requires a descriptive User-Agent identifying you (name + email).
# This is NOT an API key - it's a fair-access policy requirement.
# Example: "Jane Smith jane.smith@email.com"
SEC_EDGAR_USER_AGENT=Your Name your.email@example.com
